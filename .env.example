# Firebase Admin SDK — único jeito que o app fala com o Firestore (tudo passa pelo servidor,
# via Server Actions; não há SDK client de Firebase no bundle do browser). Também é o banco por
# trás do better-auth (tabelas user/session/account/verification, via better-auth-firestore).
# Gere em Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada.
# Copie os valores de "project_id", "client_email" e "private_key" do JSON baixado.
# FIREBASE_PRIVATE_KEY deve manter as aspas e os "\n" literais (não quebras de linha reais).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# better-auth
# BETTER_AUTH_SECRET: string aleatória usada pra assinar sessões. Gere com `openssl rand -base64 32`.
# BETTER_AUTH_URL: URL onde o app roda. Local: http://localhost:3000. Produção: o domínio real do deploy.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (usado pelo better-auth pro login social) — Google Cloud Console > APIs & Services >
# Credentials > OAuth 2.0 Client IDs. Reaproveite o client "Web client (auto created by Google
# Service)" que o Firebase já criou no mesmo projeto, ou crie um novo.
# Authorized redirect URIs precisa incluir:
#   http://localhost:3000/api/auth/callback/google           (dev)
#   https://<domínio-de-produção>/api/auth/callback/google   (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lista de e-mails autorizados a logar no painel, separados por vírgula.
AUTH_ALLOWED_EMAILS=mail@gmail.com

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=