rules_version = '2';

// Todo acesso ao Firestore (dados financeiros e tabelas do better-auth) passa
// pelo Admin SDK no servidor (Server Actions), que ignora estas regras. Elas
// existem só como cinto de segurança contra qualquer acesso direto do client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
